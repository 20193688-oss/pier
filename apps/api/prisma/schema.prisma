// pedospe: the API's datastore.
//
// Tenancy: an Organization (a business, a merchant, or both) owns everything
// below it, per TIER: `live` (mainnet, `pk_live_` keys) or `test` (testnets,
// `pk_test_` keys). Every query filters by organization AND tier, so another
// tier's row is the 404 of a missing one.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// --- tenancy and access -----------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  // The built-in origin of the public app's orders (`/v1/app/*`): it has no
  // members and no keys, and is never listed.
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          Member[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  accounts         P2pAccount[]
  quotes           P2pQuote[]
  orders           P2pOrder[]
  charges          P2pCharge[]
  payoutBatches    P2pPayoutBatch[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The Stellar account (G...) that signs in (SEP-10).
  address        String
  // owner | admin | member
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, address])
  @@index([address])
  @@map("member")
}

// A single-use SEP-10 challenge: issued for one account, then spent by
// exactly one sign-in (`session`) or one wallet registration (`account`,
// bound to an organization and tier).
model AuthChallenge {
  // The challenge's random manage_data value (48 bytes, base64).
  nonce          String    @id
  // session | account
  purpose        String
  account        String
  network        String
  organizationId String?
  tier           String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
  @@map("auth_challenge")
}

// A wallet's session: only the SHA-256 of its token is kept.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  address    String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([address])
  @@index([expiresAt])
  @@map("session")
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // live | test, decided by the key's prefix (pk_live_ / pk_test_).
  tier           String
  name           String
  // The first characters of the key, shown in lists (`pk_test_AbCd`).
  prefix         String
  // SHA-256 of the whole key, hex; the key itself is shown once.
  hash           String       @unique
  scopes         String[]
  createdBy      String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, tier])
  @@map("api_key")
}

model AuditLog {
  id           String   @id @default(cuid())
  // The wallet (or `system`) that acted.
  actor        String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_log")
}

// --- webhooks -------------------------------------------------------------------

model WebhookEndpoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier           String
  url            String
  description    String?
  // Event types it receives; empty = every event.
  events         String[]
  // The signing secret, sealed at rest (AES-256-GCM) under the endpoint's id.
  secret         String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId, tier])
  @@map("webhook_endpoint")
}

// The durable outbox: written in the same transaction as the state change it
// reports, with one delivery per subscribed endpoint.
model WebhookEvent {
  id             String   @id
  organizationId String
  tier           String
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId, tier, createdAt])
  @@map("webhook_event")
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  eventId       String
  event         WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // pending | delivered | failed
  status        String          @default("pending")
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastAttemptAt DateTime?
  lastStatus    Int?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_delivery")
}

// --- P2P market -------------------------------------------------------------------

model P2pAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier           String
  // A Stellar account (G...), proven by a SEP-10-shaped challenge bound to
  // the organization and tier.
  address        String
  label          String?
  verifiedAt     DateTime

  // The merchant profile shown on quotes (never the address). SUSPENDED is
  // set by the platform only.
  displayName          String?
  merchantStatus       String    @default("ACTIVE")
  completedOrders      Int       @default(0)
  // Orders the merchant had to act on and did not.
  cancelledOrders      Int       @default(0)
  disputesLost         Int       @default(0)
  medianReleaseSeconds Int?
  lastActiveAt         DateTime?
  // What the indexer saw this account grant: { "<network>": { "<operator>": bits } }.
  operators            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentMethods P2pPaymentMethod[]
  offers         P2pOffer[]
  merchantOrders P2pOrder[]         @relation("P2pOrderMerchant")

  // One organization per address and tier, so merchant orders and payouts
  // are never ambiguous.
  @@unique([tier, address])
  @@index([organizationId, tier, createdAt])
  @@map("p2p_account")
}

model P2pPaymentMethod {
  id             String     @id
  accountId      String
  account        P2pAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationId String
  tier           String
  currency       String
  rail           String
  // Sealed at rest (AES-256-GCM, bound to this row and field).
  details        String
  holderName     String
  label          String?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, tier, createdAt])
  @@index([accountId, rail, currency, active])
  @@map("p2p_payment_method")
}

model P2pOffer {
  id              String     @id @default(cuid())
  accountId       String
  account         P2pAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationId  String
  tier            String
  // SELL_TOKEN (the merchant sells tokens: people buy) or BUY_TOKEN.
  side            String
  network         String
  token           String
  currency        String
  rails           String[]
  // Local money per one token, decimal.
  price           String
  priceUpdatedAt  DateTime
  priceTtlSeconds Int
  // Local money bounds per order, decimal.
  minFiat         String
  maxFiat         String
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tier, network, token, currency, side, active])
  @@index([organizationId, tier, createdAt])
  @@map("p2p_offer")
}

model P2pQuote {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier              String
  // The public app's wallet the quote was made for; null for API quotes.
  endUserAddress    String?
  // The person's side: BUY (they receive tokens) or SELL (they send them).
  side              String
  // BUY | SELL | QR_PAY (a SELL whose local money pays a scanned merchant QR).
  kind              String
  // QR_PAY: SHA-256 of the scanned payload, which the order must repeat.
  qrHash            String?
  network           String
  token             String
  currency          String
  rail              String
  offerId           String
  merchantAccountId String
  price             String
  fiatAmount        String
  // Base units: what the order locks, and what its buyer receives after fees.
  tokenAmount       String
  netAmount         String
  protocolFeeBps    Int
  protocolFee       String
  integratorFeeBps  Int
  integratorFee     String
  integratorAddress String?
  bond              String
  expiresAt         DateTime
  createdAt         DateTime     @default(now())

  @@index([organizationId, tier, createdAt])
  @@index([expiresAt])
  @@map("p2p_quote")
}

model P2pOrder {
  id                      String          @id
  // SHA-256 of the uuid's 16 bytes, hex: the order's on-chain `ref_id`.
  ref                     String          @unique
  organizationId          String
  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier                    String
  // BUY | SELL | QR_PAY | CHARGE | PAYOUT
  kind                    String
  // The public app's wallet that owns this order (BUY recipient, SELL seller).
  endUserAddress          String?
  network                 String
  contract                String
  token                   String
  tokenSymbol             String
  tokenDecimals           Int
  merchantAccountId       String?
  merchantAccount         P2pAccount?     @relation("P2pOrderMerchant", fields: [merchantAccountId], references: [id], onDelete: SetNull)
  // The merchant's organization, for its own views and webhooks.
  merchantOrganizationId  String
  merchantAddress         String
  merchantDisplayName     String?
  merchantPaymentMethodId String?
  offerId                 String?
  offerSnapshot           Json
  quoteId                 String?         @unique
  price                   String
  fiatAmount              String
  currency                String
  rail                    String
  // Base units.
  tokenAmount             String
  netAmount               String
  protocolFeeBps          Int
  integratorFeeBps        Int
  integratorAddress       String?
  sellerAddress           String
  buyerAddress            String
  bond                    String
  acceptWindow            Int
  paymentWindow           Int
  settleWindow            Int
  // Who must open it: the matcher, or the person selling (`openWithDeposit`).
  openerAddress           String
  onchainId               String?
  chainStatus             String?
  status                  String          @default("pending")
  acceptDeadline          DateTime?
  paymentDeadline         DateTime?
  paidAt                  DateTime?
  endedAt                 DateTime?
  openTxHash              String?
  acceptTxHash            String?
  paidTxHash              String?
  releaseTxHash           String?
  cancelTxHash            String?
  disputeTxHash           String?
  resolveTxHash           String?
  // What it paid out when it ended: { toBuyer, toSeller, bondToSeller, protocolFee, integratorFee }.
  settlement              Json?
  // Sealed at rest: the payer's identity (purchases, charges) and the
  // beneficiary's account (sales, payouts), shown only to the merchant of a
  // live order.
  payerInfo               String?
  beneficiary             String?
  // QR_PAY: the scanned merchant QR (payload and what it reads), sealed at
  // rest; shown only to the merchant of a live order.
  qrPayload               String?
  paidReference           String?
  failureReason           String?
  chargeId                String?
  charge                  P2pCharge?      @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  payoutBatchId           String?
  payoutBatch             P2pPayoutBatch? @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  externalReference       String?
  // A checkout order's payer session: SHA-256 of its token, and its client (HMAC).
  payerTokenHash          String?         @unique
  clientKey               String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([tier, network, contract, onchainId])
  @@index([organizationId, tier, createdAt])
  @@index([merchantOrganizationId, tier, createdAt])
  @@index([endUserAddress, tier, createdAt])
  @@index([merchantAccountId, status])
  @@index([status, updatedAt])
  @@index([chargeId, status])
  @@index([payoutBatchId])
  @@map("p2p_order")
}

model P2pCharge {
  id                 String       @id
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier               String
  network            String
  token              String
  currency           String
  fiatAmount         String
  recipientAccountId String
  recipientAddress   String
  // The name the payer sees as who charges them.
  payeeName          String
  description        String?
  // Several payers may pay it (one live order each); otherwise one at a time.
  multiUse           Boolean      @default(false)
  // open | paid | cancelled (`expired` is read, never stored).
  status             String       @default("open")
  paidCount          Int          @default(0)
  paidAt             DateTime?
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  orders   P2pOrder[]
  payments P2pChargePayment[]

  @@index([organizationId, tier, createdAt])
  @@map("p2p_charge")
}

model P2pPayoutBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier           String
  network        String
  token          String
  accountId      String
  sellerAddress  String
  itemCount      Int
  // Items no merchant could take when the batch was created.
  failedItems    Json?
  // processing | completed | partially_completed | failed
  status         String       @default("processing")
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders P2pOrder[]

  @@index([organizationId, tier, createdAt])
  @@map("p2p_payout_batch")
}

// Every transaction the matcher sends, in order. A call is `queued` until
// the matcher has no other transaction in flight on its network (Stellar
// takes one transaction per source account per ledger), then signed and
// WRITTEN here before it is broadcast; only these bytes are ever sent again.
model P2pMatcherTx {
  id          String    @id @default(cuid())
  tier        String
  network     String
  fromAddress String
  // open | markPaid | cancel | dispute
  kind        String
  orderId     String?
  // The operation, base64 XDR, as it was asked for.
  operation   String
  // Set when signed.
  sequence    BigInt?
  hash        String?   @unique
  raw         String?
  maxTime     DateTime?
  // queued | signed | sent | mined | reverted | dropped
  status      String    @default("queued")
  sentAt      DateTime?
  ledger      Int?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tier, network, fromAddress, sequence])
  @@index([network, status, createdAt])
  @@index([status, updatedAt])
  @@index([orderId])
  @@map("p2p_matcher_tx")
}

// Where the indexer is in a deployment's events: RPC `getEvents`' paging
// cursor, and the last ledger it covered.
model P2pChainCursor {
  tier       String
  network    String
  contract   String
  cursor     String?
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([tier, network, contract])
  @@map("p2p_chain_cursor")
}

// --- the payments app ---------------------------------------------------------

// A wallet's public profile: its `@handle` (lower case, unique).
model AppProfile {
  address   String   @id
  handle    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_profile")
}

// A token transfer between wallets: made through the app (`origin = app`),
// or an incoming payment seen on-chain (`origin = external`).
model AppTransfer {
  id          String    @id
  tier        String
  network     String
  // The token's Stellar Asset Contract (C...).
  token       String
  tokenSymbol String
  // Base units (7 decimals).
  amount      String
  fromAddress String
  // As given: G, M or C.
  toAddress   String
  // The G account behind an M address, or the address itself.
  toAccount   String
  note        String?
  // PENDING | SUBMITTED | COMPLETED | FAILED
  status      String    @default("PENDING")
  // app | external
  origin      String    @default("app")
  // The inner transaction's hash (app), or the transaction seen (external).
  hash        String?
  // The on-chain event an external transfer was read from.
  eventId     String?   @unique
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([fromAddress, network, createdAt])
  @@index([toAccount, network, createdAt])
  @@index([hash])
  @@index([status, updatedAt])
  @@map("app_transfer")
}

// How far the incoming payments of one wallet were read on one network.
model AppIncomingScan {
  address    String
  network    String
  lastLedger Int
  updatedAt  DateTime @updatedAt

  @@id([address, network])
  @@map("app_incoming_scan")
}

// A transaction a wallet signed and the API submitted (fee-bumped by the
// sponsor when gasless is on). Written BEFORE it is broadcast; only these
// bytes are ever sent again.
model P2pSubmission {
  id             String    @id @default(cuid())
  // The inner transaction's hash, hex.
  hash           String    @unique
  // The sponsor's fee-bump's hash, when sponsored.
  feeBumpHash    String?   @unique
  tier           String
  network        String
  // app (a wallet session) | org (an organization's account)
  channel        String
  organizationId String?
  source         String
  // invoke | sac_transfer | payment | activation
  kind           String
  // The signed inner envelope, base64.
  envelope       String
  // The signed fee-bump envelope, base64; null when submitted as signed.
  outer          String?
  sponsored      Boolean
  // What the sponsor committed: the fee-bump's fee, and the reserves it sponsors.
  feeStroops     BigInt    @default(0)
  reserveStroops BigInt    @default(0)
  // HMAC of the caller's address (an IPv4 or an IPv6 /48).
  clientKey      String?
  // PENDING | SUCCESS | FAILED
  status         String    @default("PENDING")
  error          String?
  maxTime        DateTime
  ledger         Int?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([source, createdAt])
  @@index([clientKey, createdAt])
  @@index([status, updatedAt])
  @@index([createdAt])
  @@map("p2p_submission")
}

// A charge paid with tokens from a wallet's balance (no merchant in between).
model P2pChargePayment {
  id               String    @id
  chargeId         String
  charge           P2pCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  tier             String
  network          String
  token            String
  tokenSymbol      String
  // Base units: what the business receives.
  amount           String
  payerAddress     String
  recipientAddress String
  // PENDING | SUBMITTED | COMPLETED | FAILED | EXPIRED
  status           String    @default("PENDING")
  // The hash of the transaction the API built for it.
  hash             String    @unique
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([chargeId, status])
  @@index([payerAddress, createdAt])
  @@index([status, updatedAt])
  @@map("p2p_charge_payment")
}
