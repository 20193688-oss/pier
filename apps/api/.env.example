# Midpoint API environment. Every value is validated at boot (src/config/env.ts);
# a bad value stops the service with the full list of problems.
# For a local market, `npm run dev:stack` writes its own .dev-stack/api.env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Required. Postgres 14+.
DATABASE_URL=postgresql://midpoint:midpoint@127.0.0.1:54339/midpoint
# The product's name, in one place (the product will be renamed).
BRAND_NAME=Midpoint
# Where this API is reachable (links it hands out). Default http://localhost:<PORT>.
PUBLIC_API_URL=
# Browser origins allowed with credentials (CORS) and for cookie-authenticated writes (CSRF).
WEB_ORIGINS=http://localhost:3000
# Proxy hops in front of the API (1 behind nginx), so client addresses are real.
TRUST_PROXY=0

# SEP-10 sign-in. The home domain is the web host (the web proxies /v1 and /.well-known here).
SEP10_HOME_DOMAIN=localhost:3000
# The host of the auth endpoint (default: the home domain).
SEP10_WEB_AUTH_DOMAIN=
# local | testnet | mainnet; default mainnet when APP_TIER=live, else testnet.
SEP10_NETWORK=
# Signs challenges only; never funded. Required in production.
SEP10_SIGNING_SECRET=
SESSION_TTL_SECONDS=604800
# Session cookie `Secure` flag; defaults to true in production.
COOKIE_SECURE=
# Accounts (G..., comma-separated) allowed on /v1/admin/*.
ADMIN_ADDRESSES=

# Required. 32 bytes (64 hex or base64): AES-256-GCM key for payment details, payer and
# beneficiary data, scanned QR codes and webhook secrets at rest. openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Stellar networks: testnet has public defaults; mainnet needs your own RPC. Horizon is optional.
STELLAR_TESTNET_RPC_URL=
STELLAR_TESTNET_HORIZON_URL=
STELLAR_MAINNET_RPC_URL=
STELLAR_MAINNET_HORIZON_URL=
# The local quickstart network (dev only, refused in production).
STELLAR_LOCAL_RPC_URL=
STELLAR_LOCAL_HORIZON_URL=

# The market contract (C...) per network, and the ledger its indexer starts from.
P2P_TESTNET_CONTRACT=
P2P_TESTNET_START_LEDGER=
P2P_MAINNET_CONTRACT=
P2P_MAINNET_START_LEDGER=
P2P_LOCAL_CONTRACT=
P2P_LOCAL_START_LEDGER=
# Extra tokens besides Circle's USDC (never on mainnet): JSON [{"code":"TUSD","issuer":"G..."}].
P2P_TESTNET_TOKENS=
P2P_LOCAL_TOKENS=

# The three server keys must be three distinct keys (production refuses otherwise). None can
# move anyone's tokens.
# The matcher: opens orders within each seller's cap and acts for buyers; pays its own fees.
P2P_MATCHER_SECRET=
# The fee-bump and reserve sponsor (gasless). Holds only XLM. Empty: gasless is off.
P2P_SPONSOR_SECRET=
P2P_MERCHANT_MAX_OPEN_ORDERS=5
P2P_RPC_TIMEOUT_MS=15000
# The hosted charge page; a charge's link is <CHECKOUT_URL>/<chargeId>. Default <first WEB_ORIGINS>/pay.
CHECKOUT_URL=

# The sponsor's limits: the largest inner fee it bumps (stroops), its daily budget of fees plus
# reserves (XLM, per network, UTC day), sponsored submissions per account and per client IP per
# hour, and sponsored activations per client IP per day.
SPONSOR_MAX_FEE_STROOPS=2000000
SPONSOR_DAILY_BUDGET_XLM=200
SPONSOR_ADDRESS_LIMIT_PER_HOUR=60
SPONSOR_IP_LIMIT_PER_HOUR=240
SPONSOR_ACTIVATIONS_PER_IP_PER_DAY=5

# The public app (/v1/app/*): its tier, an optional integrator fee and per-wallet limit.
APP_TIER=live
APP_INTEGRATOR_ADDRESS=
APP_INTEGRATOR_FEE_BPS=0
APP_MAX_LIVE_ORDERS_PER_WALLET=3

# Jobs (indexer, expiry, matcher follower, submission follower, webhook sender), one runner each.
JOBS_ENABLED=true
JOB_INTERVAL_MS=5000
WEBHOOK_INTERVAL_MS=2000
WEBHOOK_TIMEOUT_MS=10000
# Development only (refused in production): http:// and private webhook destinations.
WEBHOOKS_ALLOW_INSECURE=false

# Development only (refused in production): /v1/dev/* (simulate a bank transfer on a test
# network) and the dev accounts' secrets it signs with.
DEV_TOOLS=false
DEV_WALLET_SECRETS=
