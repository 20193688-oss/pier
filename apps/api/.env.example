# pedospe API environment. Every value is validated at boot (src/config/env.ts);
# a bad value stops the service with the full list of problems.
# For a local market, `npm run dev:stack` writes its own .dev-stack/api.env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Required. Postgres 14+.
DATABASE_URL=postgresql://pedospe:pedospe@127.0.0.1:54329/pedospe
# Where this API is reachable (links it hands out). Default http://localhost:<PORT>.
PUBLIC_API_URL=
# Browser origins allowed with credentials (CORS) and for cookie-authenticated writes (CSRF).
WEB_ORIGINS=http://localhost:3000
# Proxy hops in front of the API (1 behind nginx), so client addresses are real.
TRUST_PROXY=0

# Sign-In with Ethereum: the domain (host[:port]) of the web app that builds SIWE messages.
SIWE_DOMAIN=localhost:3000
SIWE_NONCE_TTL_SECONDS=600
SESSION_TTL_SECONDS=604800
# Session cookie `Secure` flag; defaults to true in production.
COOKIE_SECURE=
# Wallets (comma-separated) allowed on /v1/admin/*.
ADMIN_ADDRESSES=

# Required. 32 bytes (64 hex or base64): AES-256-GCM key for payment details, payer and
# beneficiary data and webhook secrets at rest. Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# P2PMarket deployments per tier, JSON {networkId: address}. Networks: eth, base, arb, op,
# pol, bsc, avax, monad (and `local`, the dev chain, test tier only, never in production).
P2P_CONTRACTS_LIVE={}
P2P_CONTRACTS_TEST={}
# Blocks the indexer starts from, JSON {networkId: block}.
P2P_DEPLOY_BLOCKS_LIVE={}
P2P_DEPLOY_BLOCKS_TEST={}
# Nodes, JSON {networkId: url}. Required for every live network; test networks have public defaults.
P2P_RPC_URLS_LIVE={}
P2P_RPC_URLS_TEST={}
# The local dev chain's tokens, JSON [{symbol, address, decimals}] (only with `local`).
P2P_LOCAL_TOKENS=[]
# The matcher's key (0x + 64 hex): gas money and the authority sellers grant it, nothing else.
# Required once a contract is configured. Never equal to DATA_ENCRYPTION_KEY.
P2P_MATCHER_PRIVATE_KEY=
P2P_MERCHANT_MAX_OPEN_ORDERS=5
P2P_RPC_TIMEOUT_MS=10000
# The hosted charge page; a charge's link is <CHECKOUT_URL>/<chargeId>. Default <first WEB_ORIGINS>/pay.
CHECKOUT_URL=

# The public app (/v1/app/*): its tier, an optional integrator fee and per-wallet limit.
APP_TIER=live
APP_INTEGRATOR_ADDRESS=
APP_INTEGRATOR_FEE_BPS=0
APP_MAX_LIVE_ORDERS_PER_WALLET=3

# Jobs (indexer, expiry, matcher follower, webhook sender), one runner per job across replicas.
JOBS_ENABLED=true
JOB_INTERVAL_MS=5000
WEBHOOK_INTERVAL_MS=2000
WEBHOOK_TIMEOUT_MS=10000
# Development only (refused in production): http:// and private webhook destinations.
WEBHOOKS_ALLOW_INSECURE=false

# Development only (refused in production): /v1/dev/* (simulate a bank transfer on chain 31337)
# and the dev wallets' keys it signs with.
DEV_TOOLS=false
DEV_WALLET_KEYS=
