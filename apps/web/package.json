{
  "name": "@pedospe/web",
  "version": "0.1.0",
  "private": true,
  "description": "pedospe web app: the public buy/sell app, the hosted charge page, the merchant dashboard and the docs",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api-types.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pedospe/contracts": "0.1.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@pedospe/payment-qr": "0.1.0",
    "@pollar/core": "0.12.0",
    "@pollar/react": "0.12.0",
    "@stellar/stellar-sdk": "17.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  }
}
