# The dev server's port (npm run dev).
PORT=3000
# The API the dev server proxies /v1/* and /.well-known/* to (also read from API_URL, VITE_API_URL,
# PUBLIC_API_URL).
PEDOSPE_API_URL=http://localhost:4000
# The tier the app trades on: the API's APP_TIER (live unless set; a local stack is test). A
# development server falls back to test when live has no market. Pollar's network follows it.
VITE_APP_TIER=
# The Pollar app's publishable key (see README: "The Pollar app the owner must set up"). Empty:
# no Pollar; use mock mode or, in development, the dev-key wallet.
VITE_POLLAR_PUBLISHABLE_KEY=
# The home domain and web auth domain a SEP-10 challenge must name (the API's SEP10_HOME_DOMAIN).
# Empty: this page's host.
VITE_SEP10_HOME_DOMAIN=
VITE_SEP10_WEB_AUTH_DOMAIN=
# Production builds: the API's origin when it is not served from the same origin as the web app.
# Leave empty to call /v1/* on the web app's own origin.
VITE_API_BASE_URL=
