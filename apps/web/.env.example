# The dev server's port (npm run dev). 3000 matches the API's default SIWE domain and web origin.
PORT=3000
# The API the dev server proxies /v1/* to (also read from API_URL, VITE_API_URL, PUBLIC_API_URL).
PEDOSPE_API_URL=http://localhost:4000
# The tier the public buy/sell app trades on: the API's APP_TIER (live unless set; a local stack on
# the development chain is test). A development server falls back to test when live has no market.
VITE_APP_TIER=
# Production builds: the API's origin when it is not served from the same origin as the web app.
# Leave empty to call /v1/* on the web app's own origin.
VITE_API_BASE_URL=
