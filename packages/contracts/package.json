{
  "name": "@pedospe/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "The P2PMarket contract, its compiled artifact and an in-process EVM to test it",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/p2p-market.artifact.d.ts",
      "default": "./dist/p2p-market.artifact.js"
    },
    "./testing": {
      "types": "./dist/in-process-evm.d.ts",
      "default": "./dist/in-process-evm.js"
    }
  },
  "scripts": {
    "compile": "node scripts/compile.ts && prettier --write src/p2p-market.artifact.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "vitest": "5.1.1"
  },
  "files": [
    "dist",
    "contracts"
  ],
  "dependencies": {
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "solc": "0.8.37",
    "viem": "2.58.1"
  }
}
